# Plantilla de configuración del backend. Copiar a .env (ignorado por git).
# En desarrollo, usuario, contraseña y base deben coincidir con vinculo/docker/.env.
VINCULO_DATABASE_URL=postgresql://vinculo:cambiar-esta-contrasena@127.0.0.1:5432/vinculo

# Secreto para firmar los JWT (HS256). Mínimo 43 caracteres (256 bits). Generarlo con:
#   openssl rand -base64 48
# Nunca reutilizarlo entre entornos ni versionarlo.
JWT_SECRET=

# Vigencia del token en segundos (60 a 86400). 1800 = 30 min (RNF-15).
JWT_EXPIRATION=1800
